# Local development. Set ENVIRONMENT=production only with all production secrets below.
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://stockiq:change-me@localhost:3306/stockiq
# Production requires verified TLS with an explicit CA file or CA directory:
# ?ssl_mode=VERIFY_IDENTITY&ssl_ca=/etc/ssl/certs/ca.pem
# or: ?ssl_capath=/etc/ssl/certs&ssl_mode=VERIFY_CA
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
# Bootstrap creates demo users from these in development; required in production.
ADMIN_PASSWORD=change-me
STAFF_PASSWORD=change-me
# Docs/OpenAPI default to enabled in development and disabled in production.
# DOCS_ENABLED=true
# OPENAPI_ENABLED=true

# Intelligence Engine (read-only rule-based analytics)
LOOKBACK_DAYS=30
REVIEW_PERIOD_DAYS=7
MIN_HISTORY_DAYS=7
# Required only for pytest: exact name of the isolated test database.
# STOCKIQ_TEST_DB=stockiq_test
